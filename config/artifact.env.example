# Copy this file to config/artifact.env and replace placeholders locally.
# config/artifact.env is ignored by Git.

# Subject repositories used by the benchmark scripts.
TATG_SUBJECTS_ROOT=/absolute/path/to/defects4j-subjects
TATG_NEW_SUBJECTS_ROOT=/absolute/path/to/additional-subjects

# Runtime executables and JDK installations.
TATG_PYTHON=/absolute/path/to/python
TATG_MAVEN_BIN=/absolute/path/to/mvn
TATG_JAVA11_HOME=/absolute/path/to/jdk-11
TATG_JAVA24_HOME=/absolute/path/to/recent-jdk
TATG_LMS_BIN=/absolute/path/to/lms

# Optional extra executable directories, separated by the platform path separator.
TATG_EXTRA_PATH=

# Persistent or temporary output locations.
TATG_HARD_METHOD_OUT_DIR=./artifacts/hard-methods
TATG_HARD_METHOD_SOURCE_OUT_DIR=./artifacts/hard-method-source
TATG_NEW_PROJECTS_OUT_DIR=./artifacts/new-projects
TATG_FOUR_CLASS_OUT_DIR=./artifacts/four-class
TATG_MEMORY_DIR=./artifacts/memory

# OpenAI-compatible endpoint configuration. Store the key itself only in the
# environment variable named by TATG_API_KEY_ENV.
TATG_API_BASE=https://example.invalid/v1
TATG_MODEL=provider/model-name
TATG_API_KEY_ENV=OPENAI_API_KEY
